  <diagram id="exercise-state-machine" name="8 - Exercise State Machine">
    <mxGraphModel dx="1155" dy="694" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#17365D;" value="UML State Machine — Exercise Repetition Phase" vertex="1">
          <mxGeometry height="40" width="500" x="300" y="25" as="geometry" />
        </mxCell>
        <mxCell id="initial" parent="1" style="ellipse;html=1;aspect=fixed;fillColor=#17365D;strokeColor=#17365D;" value="" vertex="1">
          <mxGeometry height="24" width="24" x="95" y="405" as="geometry" />
        </mxCell>
        <mxCell id="rest" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#4472C4;strokeWidth=2;fontSize=14;" value="&lt;b&gt;REST&lt;/b&gt;&lt;br&gt;Start position / angle&lt;br&gt;inside rest range" vertex="1">
          <mxGeometry height="95" width="190" x="185" y="375" as="geometry" />
        </mxCell>
        <mxCell id="transition" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=14;" value="&lt;b&gt;TRANSITION&lt;/b&gt;&lt;br&gt;Angle in middle&lt;br&gt;movement range" vertex="1">
          <mxGeometry height="95" width="190" x="475" y="375" as="geometry" />
        </mxCell>
        <mxCell id="complete" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F0D9;strokeColor=#70AD47;strokeWidth=2;fontSize=14;" value="&lt;b&gt;COMPLETE&lt;/b&gt;&lt;br&gt;Angle reaches&lt;br&gt;exercise endpoint" vertex="1">
          <mxGeometry height="95" width="190" x="765" y="375" as="geometry" />
        </mxCell>
        <mxCell id="s1" edge="1" parent="1" source="initial" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4472C4;" target="rest" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" edge="1" parent="1" source="rest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4472C4;fontSize=12;" target="transition" value="angle leaves rest range">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" edge="1" parent="1" source="transition" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#70AD47;fontSize=12;" target="complete" value="angle reaches complete range">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4" edge="1" parent="1" source="complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4472C4;fontSize=12;" target="transition" value="angle returns to middle range">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5" edge="1" parent="1" source="transition" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4472C4;fontSize=12;" target="rest" value="angle in rest range / [valid cycle] correct_count++ / [otherwise] incorrect_count++">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s6" edge="1" parent="1" source="transition" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#C65911;fontSize=12;" target="rest" value="after 10s inactivity / reset()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s7" edge="1" parent="1" source="complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#C65911;fontSize=12;" target="rest" value="after 10s inactivity / reset()">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s8" edge="1" parent="1" source="rest" style="edgeStyle=loopEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#70AD47;fontSize=12;" target="rest" value="same phase / no state change">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;align=left;spacing=10;" value="A repetition is counted when the phase sequence returns to REST as s1 → s2 → s3 → s2 → s1. The angle thresholds are specific to the selected exercise." vertex="1">
          <mxGeometry height="70" width="670" x="220" y="610" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
